<Window x:Class="RomStationRebase.Views.Dialogs.RebaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:RomStationRebase.Resources"
        xmlns:vm="clr-namespace:RomStationRebase.ViewModels"
        xmlns:helpers="clr-namespace:RomStationRebase.Helpers"
        xmlns:models="clr-namespace:RomStationRebase.Models"
        mc:Ignorable="d"
        Title="{x:Static res:Strings.Rebase_Title}"
        Icon="/Resources/Images/rsr-logo.ico"
        Height="720" Width="1100"
        MinHeight="620" MinWidth="960"
        WindowStyle="None" AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BackgroundBrush}"
        d:DataContext="{d:DesignInstance Type=vm:RebaseViewModel, IsDesignTimeCreatable=False}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl"       Key="S" Command="{Binding SavePresetCommand}"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding SavePresetAsCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter            x:Key="BoolToVisibilityConverter"/>
        <helpers:StringToImageSourceConverter    x:Key="StringToImageSourceConverter"/>
        <helpers:NullToVisibilityConverter       x:Key="NullToVisibilityConverter"/>

        <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width"           Value="46"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="12"/>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CloseButtonHoverBrush}"/>
                    <Setter Property="Opacity"    Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid épuré -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"               Value="{DynamicResource DataGridBackgroundBrush}"/>
            <Setter Property="Foreground"               Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="RowBackground"            Value="{DynamicResource DataGridBackgroundBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource DataGridAlternatingRowBrush}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DataGridGridLinesBrush}"/>
            <Setter Property="VerticalGridLinesBrush"   Value="Transparent"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="SelectionMode"            Value="Single"/>
            <Setter Property="SelectionUnit"            Value="FullRow"/>
            <Setter Property="RowHeight"                Value="44"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="{DynamicResource DataGridColumnHeaderBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="8,5"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DataGridCellSelectedBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style cellule pour la colonne jaquette — padding réduit -->
        <Style x:Key="CoverCellStyle" TargetType="DataGridCell"
               BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <!-- Libellé d'une option à l'intérieur d'un groupe : même ton que SectionLabel, aligné sur son contrôle -->
        <Style x:Key="OptionLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
            <Setter Property="Margin"            Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Texte adjacent à un interrupteur -->
        <Style x:Key="ToggleLabel" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Foreground"        Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin"            Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Titre d'un groupe d'options -->
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>

        <!-- Carte d'un groupe d'options : fond de surface, bord fin, coins arrondis -->
        <Style x:Key="OptionCard" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="12,10"/>
        </Style>

        <!-- Bouton − / + des compteurs -->
        <Style x:Key="StepperButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width"    Value="22"/>
            <Setter Property="Height"   Value="22"/>
            <Setter Property="Padding"  Value="0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="StepperValue" TargetType="TextBlock">
            <Setter Property="Width"             Value="32"/>
            <Setter Property="TextAlignment"     Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Margin"            Value="4,0"/>
            <Setter Property="Foreground"        Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Bouton d'action destructive : croix rouge au repos, fond rouge au survol.
             Les Style.Triggers redéfinis ici l'emportent sur le hover lavande du Button global. -->
        <Style x:Key="DangerIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground"  Value="{DynamicResource ErrorTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="{DynamicResource ErrorBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                    <Setter Property="Foreground"  Value="White"/>
                    <Setter Property="Opacity"     Value="1"/>
                </Trigger>
                <DataTrigger Binding="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Opacity"   Value="0.35"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Interrupteur de règle dans une cellule : ToggleSwitchButton réduit, figé pendant le rebase -->
        <Style x:Key="RuleToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleSwitchButton}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Coloration des lignes du DataGrid selon le statut du jeu -->
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RebaseItemStatus.Copying}">
                    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RebaseItemStatus.Extracting}">
                    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RebaseItemStatus.Failed}">
                    <Setter Property="Background" Value="{DynamicResource DataGridRowFailedBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RebaseItemStatus.Skipped}">
                    <Setter Property="Background" Value="{DynamicResource DataGridRowSkippedBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>   <!-- Titlebar -->
            <RowDefinition Height="Auto"/> <!-- Configuration -->
            <RowDefinition Height="1"/>    <!-- Séparateur -->
            <RowDefinition Height="Auto"/> <!-- Progression + stats -->
            <RowDefinition Height="1"/>    <!-- Séparateur -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
            <RowDefinition Height="48"/>   <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ── Titlebar ── -->
        <Border Grid.Row="0" Background="{DynamicResource AccentBrush}"
                MouseLeftButtonDown="Titlebar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <TextBlock Text="{x:Static res:Strings.Rebase_Title}"
                               Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                    <!-- Présélection chargée : son nom, suivi d'un point tant qu'il reste des modifications -->
                    <TextBlock Text="{Binding PresetTitleSuffix}"
                               Foreground="White" FontSize="13" Opacity="0.9"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="MaximizeButton"
                        Style="{StaticResource ChromeButton}"
                        Content="□" Click="MaximizeButton_Click"/>
                <Button Grid.Column="2"
                        Style="{StaticResource CloseButton}"
                        Content="✕" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <!-- ── Zone de configuration ── -->
        <Grid Grid.Row="1" Margin="16,12,16,12" IsEnabled="{Binding IsNotRunning}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Destination + architecture -->
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/> <!-- Trois groupes d'options -->
            </Grid.RowDefinitions>

            <!-- Ligne 1 : destination et architecture -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource SectionLabel}"
                               Text="{x:Static res:Strings.Rebase_TargetPath}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="2" Content="{x:Static res:Strings.Rebase_Browse}"
                                Command="{Binding BrowseCommand}" Padding="10,6"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2" MinWidth="280">
                    <TextBlock Style="{StaticResource SectionLabel}"
                               Text="{x:Static res:Strings.Rebase_Architecture}"/>
                    <ComboBox ItemsSource="{Binding Architectures}"
                              SelectedItem="{Binding SelectedArchitecture}"
                              DisplayMemberPath="Label"
                              ToolTip="{Binding SelectedArchitecture.Description}"
                              Padding="8,6" Height="30"/>
                    <!-- Toutes les architectures ont été supprimées : rappel sous le combo vide -->
                    <TextBlock Text="{x:Static res:Strings.Rebase_NoArchitecture_Title}"
                               FontSize="11" Margin="0,4,0,0"
                               Foreground="{DynamicResource WarningBrush}"
                               Visibility="{Binding HasNoArchitecture, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>

            <!-- Ligne 2 : trois groupes d'options de même largeur -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Présélection chargée : ce qui se règle ici lui appartient, et ne touche plus aux derniers paramètres utilisés sans elle -->
                <StackPanel Grid.Row="0" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="2,0,0,8"
                            Visibility="{Binding PresetBanner, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="12" Margin="0,1,6,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{Binding PresetBanner}" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Groupe Fichiers : archives, rangement, M3U -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource OptionCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GroupTitle}" Text="{x:Static res:Strings.Rebase_Group_Files}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource OptionLabel}"
                                       Text="{x:Static res:Strings.Rebase_Archives}"
                                       ToolTip="{x:Static res:Strings.Rebase_Archives_Tooltip}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      SelectedIndex="{Binding ArchiveModeIndex}"
                                      ToolTip="{x:Static res:Strings.Rebase_Archives_Tooltip}"
                                      Padding="6,4" Height="28">
                                <ComboBoxItem Content="{x:Static res:Strings.Rebase_Archives_AsConfigured}"/>
                                <ComboBoxItem Content="{x:Static res:Strings.Rebase_Archives_Never}"/>
                                <ComboBoxItem Content="{x:Static res:Strings.Rebase_Archives_ExtractAll}"/>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource OptionLabel}"
                                       Text="{x:Static res:Strings.Rebase_ExtractLayout}"
                                       ToolTip="{x:Static res:Strings.Rebase_ExtractLayout_Tooltip}"/>
                            <ComboBox Grid.Row="2" Grid.Column="1"
                                      SelectedIndex="{Binding ExtractLayoutIndex}"
                                      IsEnabled="{Binding IsExtractionEnabled}"
                                      ToolTip="{x:Static res:Strings.Rebase_ExtractLayout_Tooltip}"
                                      Padding="6,4" Height="28">
                                <ComboBoxItem Content="{x:Static res:Strings.Rebase_ExtractLayout_Auto}"/>
                                <ComboBoxItem Content="{x:Static res:Strings.Rebase_ExtractLayout_Subfolder}"/>
                            </ComboBox>

                            <!-- Les règles par système (romset, M3U, extraction) vivent dans l'architecture :
                                 un seul endroit décide, la fenêtre ne fait que le rappeler et y donner accès -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="{x:Static res:Strings.Rebase_Rules_Hint}"/>
                                <LineBreak/>
                                <InlineUIContainer BaselineAlignment="Center">
                                    <Button Style="{StaticResource LinkButton}" FontSize="11" Padding="0"
                                            Content="{x:Static res:Strings.Rebase_ManageArchitectures}"
                                            Command="{Binding EditArchitecturesCommand}"/>
                                </InlineUIContainer>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Groupe Métadonnées : jaquettes, gamelist, langue -->
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource OptionCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GroupTitle}" Text="{x:Static res:Strings.Rebase_Group_Metadata}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                    ToolTip="{x:Static res:Strings.Rebase_CopyCovers_Tooltip}">
                            <ToggleButton IsChecked="{Binding CopyCovers}"
                                          Style="{StaticResource ToggleSwitchButton}"/>
                            <TextBlock Style="{StaticResource ToggleLabel}" Text="{x:Static res:Strings.Rebase_CopyCovers}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                    Visibility="{Binding SupportsGamelist, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTip="{x:Static res:Strings.Rebase_GenerateGamelist_Tooltip}">
                            <ToggleButton IsChecked="{Binding GenerateGamelist}"
                                          Style="{StaticResource ToggleSwitchButton}"/>
                            <TextBlock Style="{StaticResource ToggleLabel}" Text="{Binding GenerateGamelistLabel}"/>
                        </StackPanel>

                        <!-- Métadonnées hors de l'arborescence des ROMs (ES-DE, Cocoon) : dire où elles vont et quoi en faire -->
                        <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" MaxWidth="300" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding MetadataLocationHint}"
                                   Visibility="{Binding MetadataLocationHint, Converter={StaticResource NullToVisibilityConverter}}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                    Visibility="{Binding ShowMetadataLanguage, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTip="{x:Static res:Strings.Rebase_BackupGamelist_Tooltip}">
                            <ToggleButton IsChecked="{Binding BackupGamelist}"
                                          Style="{StaticResource ToggleSwitchButton}"/>
                            <TextBlock Style="{StaticResource ToggleLabel}" Text="{x:Static res:Strings.Rebase_BackupGamelist}"/>
                        </StackPanel>

                        <Grid Margin="0,10,0,0"
                              Visibility="{Binding ShowMetadataLanguage, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource OptionLabel}"
                                       Text="{x:Static res:Strings.Rebase_MetadataLanguage}"/>
                            <ComboBox Grid.Column="1"
                                      SelectedIndex="{Binding MetadataLanguageIndex}"
                                      Padding="6,4" Height="28">
                                <ComboBoxItem Content="{x:Static res:Strings.Rebase_MetadataLanguage_Fr}"/>
                                <ComboBoxItem Content="{x:Static res:Strings.Rebase_MetadataLanguage_En}"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Groupe Copie : doublons, copies concurrentes, tentatives, délai -->
                <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource OptionCard}" MinWidth="300">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GroupTitle}" Text="{x:Static res:Strings.Rebase_Group_Copy}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>   <!-- Label -->
                                <ColumnDefinition Width="Auto"/>   <!-- Bouton − ou ComboBox -->
                                <ColumnDefinition Width="Auto"/>   <!-- Valeur -->
                                <ColumnDefinition Width="Auto"/>   <!-- Bouton + -->
                                <ColumnDefinition Width="Auto"/>   <!-- Unité (ligne Délai) -->
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Doublons -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource OptionLabel}"
                                       Text="{x:Static res:Strings.Rebase_DuplicatePolicy}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4"
                                      SelectedIndex="{Binding DuplicatePolicyIndex}"
                                      Padding="6,4" Height="28" MinWidth="150">
                                <ComboBoxItem Content="{x:Static res:Strings.Rebase_DuplicatePolicy_Ignore}"/>
                                <ComboBoxItem Content="{x:Static res:Strings.Rebase_DuplicatePolicy_Overwrite}"/>
                            </ComboBox>

                            <!-- Copies concurrentes -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource OptionLabel}"
                                       Text="{x:Static res:Strings.Rebase_ParallelCopies}"/>
                            <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource StepperButton}"
                                    Content="−" Command="{Binding DecrementParallelCommand}"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource StepperValue}"
                                       Text="{Binding MaxParallelCopies}"/>
                            <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource StepperButton}"
                                    Content="+" Command="{Binding IncrementParallelCommand}"/>

                            <!-- Tentatives -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource OptionLabel}"
                                       Text="{x:Static res:Strings.Rebase_RetryAttempts}"/>
                            <Button Grid.Row="4" Grid.Column="1" Style="{StaticResource StepperButton}"
                                    Content="−" Command="{Binding DecrementRetryCommand}"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource StepperValue}"
                                       Text="{Binding RetryCount}"/>
                            <Button Grid.Row="4" Grid.Column="3" Style="{StaticResource StepperButton}"
                                    Content="+" Command="{Binding IncrementRetryCommand}"/>

                            <!-- Délai entre tentatives -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource OptionLabel}"
                                       Text="{x:Static res:Strings.Rebase_RetryDelay}"/>
                            <Button Grid.Row="6" Grid.Column="1" Style="{StaticResource StepperButton}"
                                    Content="−" Command="{Binding DecrementRetryDelayCommand}"/>
                            <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource StepperValue}"
                                       Text="{Binding RetryDelay}"/>
                            <Button Grid.Row="6" Grid.Column="3" Style="{StaticResource StepperButton}"
                                    Content="+" Command="{Binding IncrementRetryDelayCommand}"/>
                            <TextBlock Grid.Row="6" Grid.Column="4"
                                       Text="{x:Static res:Strings.Rebase_RetryDelayUnit}"
                                       VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Séparateur -->
        <Rectangle Grid.Row="2" Fill="{DynamicResource BorderBrush}"/>

        <!-- ── Barre de progression + stats ── -->
        <Grid Grid.Row="3" Margin="16,10,16,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Value piloté exclusivement par BeginAnimation — pas de binding ni de Style pour éviter tout conflit -->
            <ProgressBar x:Name="RebaseProgressBar" Grid.Row="0"
                         Minimum="0" Maximum="100" Height="6"
                         Foreground="{DynamicResource ProgressBarFillBrush}" Background="{DynamicResource ProgressBarTrackBrush}" BorderThickness="0"/>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding SpeedText}"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="16,0,16,0"/>
                <TextBlock Grid.Column="2" Text="{Binding EtaText}"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="3" Text="{Binding EstimatedSizeText}"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="16,0,0,0"/>
            </Grid>
        </Grid>

        <!-- Séparateur -->
        <Rectangle Grid.Row="4" Fill="{DynamicResource BorderBrush}"/>

        <!-- ── DataGrid jeux ── -->
        <DataGrid Grid.Row="5"
                  ItemsSource="{Binding RebaseItems}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  CanUserSortColumns="True"
                  CanUserResizeRows="False"
                  Margin="0">
            <DataGrid.Resources>
                <!-- Style implicite ScrollBar dans l'ancêtre logique direct du DataGrid -->
                <Style TargetType="ScrollBar" BasedOn="{StaticResource SidebarScrollBar}"/>
            </DataGrid.Resources>
            <DataGrid.Columns>

                <!-- Jaquette 36×36 -->
                <DataGridTemplateColumn Width="48" CanUserSort="False" CanUserResize="False"
                                        CellStyle="{StaticResource CoverCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="36" Height="36" Background="{DynamicResource DataGridCoverPlaceholderBrush}" CornerRadius="2">
                                <Image Source="{Binding CoverPath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=72}"
                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Icône statut -->
                <DataGridTextColumn Width="30" Binding="{Binding StatusIcon}" CanUserSort="False">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontSize"            Value="13"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Titre -->
                <DataGridTextColumn Header="{x:Static res:Strings.Rebase_Column_Title}"
                                    Width="*" Binding="{Binding Title}"/>

                <!-- Système avec logo 14×14 -->
                <DataGridTemplateColumn Header="{x:Static res:Strings.Rebase_Column_System}"
                                        Width="150" SortMemberPath="SystemName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{Binding SystemImagePath, Converter={StaticResource StringToImageSourceConverter}}"
                                       Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{Binding SystemName}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Fichiers — aligné à droite (convention UI pour les nombres, facilite la comparaison visuelle) -->
                <DataGridTextColumn Header="{x:Static res:Strings.Rebase_Column_Files}"
                                    Width="70" Binding="{Binding FileCount}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="0,0,12,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,12,0"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>

                <!-- Règles par système, redites depuis l'architecture et modifiables jeu par jeu pour ce rebase -->
                <DataGridTemplateColumn Width="72" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{x:Static res:Strings.Rebase_Column_Romset}"
                                   ToolTip="{x:Static res:Strings.Rebase_Column_Romset_Tooltip}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ToggleButton IsChecked="{Binding KeepFileName, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="{x:Static res:Strings.Rebase_Rule_Tooltip}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource RuleToggle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMapped}" Value="False">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="60" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{x:Static res:Strings.Rebase_Column_M3U}"
                                   ToolTip="{x:Static res:Strings.Rebase_Column_M3U_Tooltip}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ToggleButton IsChecked="{Binding M3U, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="{x:Static res:Strings.Rebase_Rule_Tooltip}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource RuleToggle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanToggleM3U}" Value="False">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="80" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{x:Static res:Strings.Rebase_Column_Extract}"
                                   ToolTip="{x:Static res:Strings.Rebase_Column_Extract_Tooltip}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ToggleButton IsChecked="{Binding Extract, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="{x:Static res:Strings.Rebase_Column_Extract_Tooltip}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource RuleToggle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanToggleExtract}" Value="False">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                            <!-- Hors du mode « selon l'architecture », la règle par système n'a plus prise -->
                                            <DataTrigger Binding="{Binding DataContext.IsExtractionAsConfigured, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="False">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Sortie prévue — l'infobulle liste les chemins qui seront écrits -->
                <DataGridTextColumn Header="{x:Static res:Strings.Rebase_Column_Output}"
                                    Width="150" Binding="{Binding OutputText}" SortMemberPath="OutputText">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip"      Value="{Binding OutputTooltip}"/>
                            <Setter Property="Foreground"   Value="{DynamicResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnmapped}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Statut texte -->
                <DataGridTextColumn Header="{x:Static res:Strings.Rebase_Column_Status}"
                                    Width="110" Binding="{Binding StatusText}"/>

                <!-- Erreur -->
                <DataGridTextColumn Header="{x:Static res:Strings.Rebase_Column_Error}"
                                    Width="180" Binding="{Binding ErrorDetail}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="Foreground"   Value="{DynamicResource ErrorTextBrush}"/>
                            <Setter Property="ToolTip"      Value="{Binding ErrorDetail}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Retirer du rebase : vrai bouton, toujours visible, rouge = action destructive ; figé pendant le rebase -->
                <DataGridTemplateColumn Width="44" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Width="30" Height="26" Padding="0"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource DangerIconButton}"
                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{x:Static res:Strings.Rebase_RemoveItem_Tooltip}">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ── Footer ── -->
        <Border Grid.Row="6" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{x:Static res:Strings.Rebase_OpenFolder}"
                            Command="{Binding OpenFolderCommand}"
                            Padding="10,6" Margin="0,0,8,0"/>
                    <Button Content="{x:Static res:Strings.Rebase_ExportLog}"
                            Command="{Binding ExportLogCommand}"
                            Padding="10,6"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Enregistrer cette configuration : à côté de Démarrer, là où se conclut ce qui vient d'être réglé.
                         Bouton scindé (« Enregistrer sous… » sous la flèche), retiré pendant un rebase. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0"
                                Visibility="{Binding IsNotRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Command="{Binding SavePresetCommand}"
                                ToolTip="{Binding SavePresetTooltip}"
                                Padding="10,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" Margin="0,1,6,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{x:Static res:Strings.Rebase_SavePreset}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="PresetMenuButton"
                                Padding="6,6" Margin="-1,0,0,0"
                                Click="OnPresetMenuButtonClick"
                                ToolTip="{x:Static res:Strings.Preset_More_Tooltip}">
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="9" VerticalAlignment="Center"/>
                        </Button>
                        <Popup x:Name="PresetMenuPopup"
                               PlacementTarget="{Binding ElementName=PresetMenuButton}"
                               Placement="Top" VerticalOffset="-4"
                               StaysOpen="False" AllowsTransparency="True"
                               Closed="OnPresetMenuClosed">
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="4" MinWidth="240" Margin="0,8,8,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25"/>
                                </Border.Effect>
                                <StackPanel Button.Click="OnPresetMenuItemClick">
                                    <Button Style="{StaticResource MenuItemButton}"
                                            Tag="{x:Static res:Strings.Preset_SaveAs_Shortcut}"
                                            Content="{x:Static res:Strings.Preset_SaveAs}"
                                            Command="{Binding SavePresetAsCommand}"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                    <Button Content="{Binding PauseResumeText}"
                            Command="{Binding PauseResumeCommand}"
                            Padding="10,6" Margin="0,0,8,0"
                            Visibility="{Binding ShowPauseResume, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="{x:Static res:Strings.Rebase_Cancel}"
                            Command="{Binding CancelCommand}"
                            Padding="10,6" Margin="0,0,8,0"
                            Visibility="{Binding ShowPauseResume, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="{x:Static res:Strings.Rebase_Cancelling}"
                            IsEnabled="False"
                            Padding="10,6" Margin="0,0,8,0"
                            Visibility="{Binding IsCancelling, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="{x:Static res:Strings.Rebase_CancelCalcTitle}"
                            Command="{Binding CancelCalculationCommand}"
                            Padding="10,6" Margin="0,0,8,0"
                            Visibility="{Binding IsSizeCalculating, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="{x:Static res:Strings.Rebase_Start}"
                            Command="{Binding StartRebaseCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="14,6"
                            Visibility="{Binding CanShowStart, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
